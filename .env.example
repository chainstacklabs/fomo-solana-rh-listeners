# Copy to .env and fill in. .env is gitignored — never commit it.

# --- EVM chains --------------------------------------------------------------
# One pair per chain in scripts/shared/evm.py. WSS drives the listeners; HTTPS answers
# the lookups they make along the way. 00_listen_fomo.py needs every pair unless the
# chain is turned off by name, e.g. `eth-off`.
ROBINHOOD_MAINNET_WSS=
ROBINHOOD_MAINNET_HTTPS=
BSC_MAINNET_WSS=
BSC_MAINNET_HTTPS=
BASE_MAINNET_WSS=
BASE_MAINNET_HTTPS=
ETHEREUM_MAINNET_WSS=
ETHEREUM_MAINNET_HTTPS=
MONAD_MAINNET_WSS=
MONAD_MAINNET_HTTPS=

# --- Solana, standard transports ---------------------------------------------
# WSS drives blockSubscribe; HTTPS is used by the trade tracer.
SOLANA_MAINNET_WSS=
SOLANA_MAINNET_HTTPS=

# --- Solana, Yellowstone gRPC (Geyser) ---------------------------------------
# The fastest Solana listener. Auth type is x-token or basic.
GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token

# --- A known FOMO wallet, used by the registry check --------------------------
KNOWN_FOMO_WALLET=

# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Robinhood Chain ---------------------------------------------------------
# WSS drives the listeners; HTTPS answers the lookups they make along the way.
ROBINHOOD_MAINNET_WSS=
ROBINHOOD_MAINNET_HTTPS=

# --- Solana, standard transports ---------------------------------------------
# WSS drives blockSubscribe; HTTPS is used by the trade tracer.
SOLANA_MAINNET_WSS=
SOLANA_MAINNET_HTTPS=

# --- Solana, Yellowstone gRPC (Geyser) ---------------------------------------
# The fastest Solana listener. Auth type is x-token or basic.
GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token

# --- A known FOMO wallet, used by the registry check --------------------------
KNOWN_FOMO_WALLET=
